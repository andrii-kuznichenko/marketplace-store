datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum MediaType {
  IMAGE
  VIDEO
}

enum Gender {
  MEN
  WOMEN
}

enum MainCategory {
  TOPS
  BOTTOMS
  DRESSES
  OUTERWEAR
  ACCESSORIES
}

enum Subcategory {
  // Tops
  T_SHIRTS
  SHIRTS
  BLOUSES
  SWEATSHIRTS
  HOODIES
  TANK_TOPS
  CROP_TOPS
  // Bottoms
  JEANS
  TROUSERS
  SHORTS
  SKIRTS
  JOGGERS
  // Outerwear
  JACKETS
  COATS
  BLAZERS
  VESTS
  // Accessories
  BAGS
  HATS
  SCARVES
  BELTS
  JEWELRY
  CHAINMAIL_PIECES
}

model Company {
  id        String    @id @default(uuid())
  name      String    @unique
  admins    Admin[]
  products  Product[]
  parcels   Parcel[]
  createdAt DateTime  @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  createdAt DateTime @default(now())
}

model ColorGroup {
  id        String    @id @default(uuid())
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id           String               @id @default(uuid())
  name         String
  description  String
  featured     Boolean
  price        Float
  clerkId      String
  company      Company              @relation(fields: [companyId], references: [id])
  companyId    String
  media        ProductMedia[]
  gender       Gender
  mainCategory MainCategory
  subcategory  Subcategory
  color        String?
  colorGroup   ColorGroup?          @relation(fields: [colorGroupId], references: [id])
  colorGroupId String?
  favourites   Favourite[]
  sizes        ProductSize[]
  customFields ProductCustomField[]
  reviews      Review[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ProductSize {
  id        String  @id @default(uuid())
  size      String
  inStock   Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model ProductCustomField {
  id        String  @id @default(uuid())
  name      String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model ProductMedia {
  id        String    @id @default(uuid())
  url       String
  type      MediaType
  order     Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model Favourite {
  id        String   @id @default(uuid())
  clerkId   String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id             String   @id @default(uuid())
  clerkId        String
  rating         Int
  comment        String
  authorName     String
  authorImageUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
}

model Cart {
  id             String     @id @default(uuid())
  clerkId        String
  cartItems      CartItem[]
  numItemsInCart Int        @default(0)
  cartTotal      Float      @default(0)
  shipping       Float      @default(5)
  tax            Float      @default(0)
  taxRate        Float      @default(0.19)
  orderTotal     Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  amount    Int
  size      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id         String   @id @default(uuid())
  clerkId    String
  name       String
  street     String
  city       String
  postalCode String
  country    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id             String      @id @default(uuid())
  clerkId        String
  parcels        Parcel[]
  orderItems     OrderItem[]
  orderTotal     Float       @default(0)
  shipping       Float       @default(0)
  email          String
  isPaid         Boolean     @default(false)
  recipientName  String
  street         String
  city           String
  postalCode     String
  country        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Parcel {
  id          String   @id @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  isDelivered Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  amount    Int
  size      String
  color     String
  price     Float
}
